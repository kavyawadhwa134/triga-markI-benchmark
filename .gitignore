# macOS litter
.DS_Store
.AppleDouble
.LSOverride
._*

# MOOSE / Exodus outputs (large; regenerate from inputs)
*.e
*.exo
*.exd
*.e-s*

# VTK / ParaView outputs (large; regenerate)
*.vtk
*.vtu
*.vti
*.vts
*.vtm
*.pvtu
*.pvd

# OpenMC generated artifacts (large; regenerate)
statepoint.*.h5
source.*.h5
tallies.out
particle*.h5

# NekRS field / checkpoint / restart files (large; regenerate)
*.fld
*.f[0-9]*
*.chk
*.par.1
nekrs_*.log

# OpenFOAM time directories and processor decomposition
[0-9]*/
[0-9]*.[0-9]*/
processor*/
postProcessing/
log.*

# Compiled / build artifacts
*.o
*.mod
*-opt
*-dbg
build/
__pycache__/
*.pyc
*.pyo

# NOTE: small CSV / probe / reference outputs (*.csv) are INTENTIONALLY
# tracked — they are the Tier 0 / Tier 2 comparison artefacts.
