#include "udf.hpp"

// Minimal v26-compatible UDF. Optional velRecycling/tavg plugins are omitted
// so the reduced TRIGA channel uses only the installed Cardinal/NekRS APIs.
void UDF_Setup(nrs_t *nrs)
{
  if (platform->options.getArgs("RESTART FILE NAME").empty())
    for (int n = 0; n < nrs->meshV->Nlocal; ++n)
    {
      nrs->U[n + 0 * nrs->fieldOffset] = 0.0;
      nrs->U[n + 1 * nrs->fieldOffset] = 0.0;
      nrs->U[n + 2 * nrs->fieldOffset] = 0.2;
    }
}

void UDF_ExecuteStep(nrs_t *, double, int)
{
}
